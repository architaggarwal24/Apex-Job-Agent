# ================================================================
# APEX JOB AGENT — ENVIRONMENT CONFIGURATION
# Copy to .env and fill in your values. Never commit .env.
# ================================================================

# ── LLM PROVIDER ─────────────────────────────────────────────────
# Options: nvidia | openrouter | gemini | ollama | anthropic | openai
LLM_PROVIDER=nvidia
LLM_TEMPERATURE=0.1

# ── NVIDIA NIM (https://integrate.api.nvidia.com) ─────────────────
NVIDIA_NIM_API_KEY=your_nvidia_key_here
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v3.2
# NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v3.1-terminus

# ── OPENROUTER (https://openrouter.ai) ────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=deepseek/deepseek-v3.2

# ── GOOGLE GEMINI (https://aistudio.google.com/app/apikey) ────────
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3-flash-preview

# ── OLLAMA — local, free (https://ollama.com) ─────────────────────
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# ── ANTHROPIC (https://console.anthropic.com) ─────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# ── OPENAI (https://platform.openai.com) ──────────────────────────
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.6-terra

# ── BROWSER ───────────────────────────────────────────────────────
# Replace <USERNAME> with your Windows username
OPERA_EXECUTABLE_PATH=C:/Users/<USERNAME>/AppData/Local/Programs/Opera/opera.exe
OPERA_USER_DATA_DIR=C:/Users/<USERNAME>/AppData/Roaming/Opera Software/Opera Stable
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=60

# ── WEB SERVER ────────────────────────────────────────────────────
# Keep on 127.0.0.1 and put a TLS reverse proxy (Caddy/nginx) in front.
APP_HOST=127.0.0.1
APP_PORT=8000

# ── SECURITY ──────────────────────────────────────────────────────
# There are deliberately NO job-site (LinkedIn/Indeed/Naukri) passwords
# anywhere in this file — sign in once in the browser window the app
# opens and the session is kept (encrypted) from then on.
#
# Session-signing key. Leave this commented out and a strong random key
# is generated into data/.session_secret. If you set it, use 32+ random
# characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_SECRET_KEY=
#
# Key that encrypts stored API keys and saved job-site sessions. Leave
# commented out to auto-generate data/.master.key (BACK IT UP — losing it
# makes encrypted data unrecoverable). For a real deployment set it here
# from your host's secret store instead of keeping it next to the data:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENCRYPTION_KEY=
#
# "true" = session cookies only travel over HTTPS (required for any real
# deployment). Set false ONLY for plain-http local development.
COOKIE_SECURE=true
#
# Account creation is closed after the first (owner) account. Do NOT set
# this to true until profile/settings/apply are migrated to per-user
# isolation — see MULTI_USER_STATUS.md.
ALLOW_SIGNUP=false

# ── AGENT BEHAVIOUR ───────────────────────────────────────────────
DRY_RUN=false
DAILY_APPLY_LIMIT=30
# Auto-skip jobs scoring below this (0 = keep all)
AUTO_SKIP_SCORE_THRESHOLD=30
MIN_DELAY_BETWEEN_APPLIES=45
MAX_DELAY_BETWEEN_APPLIES=120
